# LLM (from F10). Models per role; pick by evaluation.
OPENAI_API_KEY=
# Defaults: gpt-6-astra for every role. Any model set here needs a price in app/llm/spend.py (calls fail closed).
OPENAI_MODEL_PARSE=
OPENAI_MODEL_NARRATE=
OPENAI_MODEL_BASELINE=
LLM_MONTHLY_CAP_USD=20
# Running spend per month, so the cap survives restarts (default var/llm_spend.json).
LLM_SPEND_LEDGER=

# simulator (from F1) | fixture (legacy offline) | fli (prototype only) | serpapi
FARE_PROVIDER=fixture
SERPAPI_API_KEY=
# Free cached fares for hub pruning: https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
CURRENCY=GBP
